# RPC Provider
RPC_URL=https://polygon-rpc.com/
# For Ethereum: https://eth.rpc.thirdweb.com
# For Sepolia Testnet: https://sepolia.rpc.thirdweb.com

# Smart Contract
CONTRACT_ADDRESS=0x...
